---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataSourcesTable from '../components/DataSourcesTable.astro';
import { withBase } from '../config/site';

const LAST_UPDATED = 'October 2026 (dataset v1.0)';
const sources = [
  {
    name: 'American Community Survey (ACS) 5-Year Estimates, 2020–2024',
    publisher: 'U.S. Census Bureau',
    year: '2020–2024',
    fields: 'Population (B01003), total households (B11001), households receiving SNAP and their share (B22003).',
    link: 'https://data.census.gov/table/ACSDT5Y2024.B22003?g=040XX00US21$0500000',
  },
  {
    name: 'PLACES: Local Data for Better Health, County Data, 2024 release',
    publisher: 'Centers for Disease Control and Prevention (CDC)',
    year: '2022 (diabetes, obesity); 2021 (high blood pressure)',
    fields: 'Age-adjusted prevalence among adults of diagnosed diabetes, obesity and high blood pressure. The 2025 release does not include these measures for Kentucky, which is why the 2024 release is used.',
    link: 'https://www.cdc.gov/places',
  },
  {
    name: 'Food Environment Atlas, 2025 data download',
    publisher: 'U.S. Department of Agriculture, Economic Research Service (USDA ERS)',
    year: '2018–2023 (varies by field)',
    fields: 'Low income and low access to a store (2019), grocery stores per 1,000 residents (2020), SNAP-authorized stores (2023), farmers markets and those accepting SNAP (2018), poverty, child poverty, persistent poverty and median household income (2021), and metro or nonmetro status (2023). Grocery stores per 1,000 is withheld by USDA for 42 small counties; NourishScope shows these as “Not reported (suppressed by source)”, not zero.',
    link: 'https://www.ers.usda.gov/data-products/food-environment-atlas/',
  },
  {
    name: 'County Economic Status, Fiscal Year 2027, Kentucky',
    publisher: 'Appalachian Regional Commission (ARC)',
    year: 'FY2027',
    fields: 'Whether each county is in the Appalachian Region, and its economic status (Distressed, At-Risk, Transitional and so on). Counties outside the region show “Not applicable”.',
    link: 'https://www.arc.gov/wp-content/uploads/2026/06/CountyEconomicStatusandDistressAreasFY2027Kentucky.pdf',
  },
  {
    name: 'County FIPS codes',
    publisher: 'U.S. Census Bureau',
    year: '—',
    fields: 'County name, five-digit FIPS code and state, used to join all the sources.',
    link: 'https://www.census.gov/library/reference/code-lists/ansi.html',
  },
];
---
<BaseLayout title="Data Sources" description="Where every figure in NourishScope comes from: publisher, year, link and last update.">
  <article>
    <h1>Data Sources</h1>
    <p class="prose">
      Every figure in NourishScope comes from a free, public source. The tool shows a short source label and year next to
      each figure, for example “Source: CDC PLACES, 2022”. The data were last updated in {LAST_UPDATED}; each yearly
      refresh is recorded in the <a href={withBase('/changelog')}>changelog</a>.
    </p>

    <ol class="source-list">
      {sources.map((s) => (
        <li>
          <h2>{s.name}</h2>
          <dl>
            <div><dt>Publisher</dt><dd>{s.publisher}</dd></div>
            <div><dt>Data year</dt><dd>{s.year}</dd></div>
            <div><dt>Used for</dt><dd>{s.fields}</dd></div>
            <div><dt>Link</dt><dd><a href={s.link}>{s.link.replace(/^https:\/\//, '')}</a></dd></div>
            <div><dt>Last updated in NourishScope</dt><dd>{LAST_UPDATED}</dd></div>
          </dl>
        </li>
      ))}
    </ol>

    <h2>Your own figures</h2>
    <p class="prose">
      The number of households your program serves and your cost per household are not public. You enter them in the app,
      and they stay in your browser.
    </p>

    <h2>Every field, with its source and year</h2>
    <DataSourcesTable />

    <h2>Download the data</h2>
    <p class="prose">
      <a href={withBase('/downloads/nourishscope_ky_counties_v1.0.csv')} download>Kentucky county dataset v1.0 (CSV)</a>,
      licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Please also credit the original
      publishers listed above.
    </p>
  </article>
</BaseLayout>

<style>
  .source-list { padding-left: var(--space-5); }
  .source-list h2 { font-size: 1.2rem; }
  .source-list dl { display: grid; gap: var(--space-1); }
  .source-list dl div { display: grid; grid-template-columns: minmax(8rem, 14rem) 1fr; gap: var(--space-3); }
  .source-list dt { font-weight: 600; }
  .source-list dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .source-list dl div { grid-template-columns: 1fr; gap: 0; } }
</style>
