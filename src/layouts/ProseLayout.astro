---
import BaseLayout from './BaseLayout.astro';
import { prefixRootLinks } from '../lib/links';

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
// Markdown authors write "/app" or "/images/x.jpg"; add the deploy base path so
// those links work on GitHub Pages (plan: every internal link goes through the base).
const html = prefixRootLinks(await Astro.slots.render('default'), import.meta.env.BASE_URL);
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="prose">
    <Fragment set:html={html} />
  </article>
</BaseLayout>
