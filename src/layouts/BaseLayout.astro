---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, withBase } from '../config/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'NourishScope helps Kentucky community nutrition programs decide where to direct limited resources. Free, and everything stays in your browser.' } = Astro.props;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
    {/* Inline, so it runs before first paint and adds no script request. The saved choice wins,
        otherwise the device setting decides, and keeps deciding if it changes. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var device = matchMedia('(prefers-color-scheme: dark)');
        function saved() { try { return localStorage.getItem('theme'); } catch (e) { return null; } }
        function set(theme) {
          root.dataset.theme = theme;
          var button = document.querySelector('[data-theme-toggle]');
          if (button) button.setAttribute('aria-pressed', String(theme === 'dark'));
        }
        function fromDevice() { return device.matches ? 'dark' : 'light'; }
        set(saved() || fromDevice());
        device.addEventListener('change', function () { if (!saved()) set(fromDevice()); });
        document.addEventListener('DOMContentLoaded', function () {
          var button = document.querySelector('[data-theme-toggle]');
          if (!button) return;
          button.hidden = false;
          set(root.dataset.theme);
          button.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('theme', next); } catch (e) { /* not saved, still switches for this page */ }
            set(next);
          });
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
