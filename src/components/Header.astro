---
import { withBase } from '../config/site';

const links = [
  { href: '/about', label: 'About' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/data-sources', label: 'Data Sources' },
  { href: '/research', label: 'Research' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === withBase(href).replace(/\/$/, '');
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={withBase('/')}>
      <span aria-hidden="true" class="site-header__mark">◆</span> NourishScope
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={withBase(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    {/* Hidden until the inline theme script in BaseLayout wires it up, so it never shows as a dead button. */}
    <button type="button" class="site-header__theme" data-theme-toggle aria-pressed="false" title="Switch between light and dark" hidden>
      <span class="visually-hidden">Dark mode</span>
      <svg class="site-header__theme-moon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <svg class="site-header__theme-sun" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <circle cx="12" cy="12" r="4.5" fill="currentColor" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
        </g>
      </svg>
    </button>
    {!isCurrent('/app') && (
      <a class="button site-header__app" href={withBase('/app')} aria-label="Open the app">
        <span class="site-header__app-long">Open the app</span><span class="site-header__app-short" aria-hidden="true">App</span>
      </a>
    )}
    <details class="site-header__menu">
      <summary>
        <svg class="site-header__menu-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="site-header__menu-label">Menu</span>
      </summary>
      <nav aria-label="Main (menu)">
        <ul>
          {links.map((l) => (
            <li><a href={withBase(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    min-height: 4rem;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .site-header__brand {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-text);
    text-decoration: none;
    margin-right: auto;
  }
  .site-header__mark { color: var(--color-link); }
  .site-header__nav ul, .site-header__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-4);
  }
  .site-header__nav a, .site-header__menu a { color: var(--color-text); }
  [aria-current='page'] { font-weight: 700; }
  .site-header__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .site-header__theme[hidden] { display: none; }
  .site-header__theme:hover { background: var(--color-surface-muted); }
  .site-header__theme-sun { display: none; }
  :global([data-theme='dark']) .site-header__theme-moon { display: none; }
  :global([data-theme='dark']) .site-header__theme-sun { display: block; }
  .site-header__app { padding: var(--space-1) var(--space-4); }
  .site-header__app-short { display: none; }
  .site-header__menu-icon { display: none; }
  @media (max-width: 26.25rem) {
    .site-header__inner { gap: var(--space-2); }
    .site-header__app-long { display: none; }
    .site-header__app-short { display: inline; }
  }
  .site-header__menu { display: none; }
  .site-header__menu summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  @media (max-width: 760px) {
    /* Phones keep the header (and its Menu) pinned while scrolling. Anchor jumps clear it
       through scroll-padding-top in global.css. Printing hides the header (app.css). */
    .site-header { position: sticky; top: 0; z-index: 40; }
    .site-header__nav { display: none; }
    .site-header__menu { display: block; }
    .site-header__menu[open] { flex-basis: 100%; order: 3; }
    .site-header__menu[open] summary { display: inline-flex; }
    .site-header__menu ul { flex-direction: column; padding: var(--space-3) 0; gap: var(--space-2); }
    .site-header__menu a { display: block; padding: var(--space-2) 0; }
  }
  /*
   * Brand, theme switch, App and Menu must share one row at 375px, even with a wide system
   * font such as DejaVu Sans: Menu becomes an icon, and the brand and App button tighten.
   */
  @media (max-width: 26.25rem) {
    .site-header__brand { font-size: 1.05rem; }
    .site-header__app { padding: var(--space-1) var(--space-3); }
    .site-header__menu summary { justify-content: center; min-width: 44px; padding: 0; }
    .site-header__menu-icon { display: block; }
    .site-header__menu-label {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
  }
</style>
