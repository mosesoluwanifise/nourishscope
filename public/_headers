# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).

# Every page: no MIME sniffing, no referrer sent to other sites, no camera, microphone or location.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Built scripts and styles have a content hash in their names, so a returning visitor on a slow
# connection can keep them for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
