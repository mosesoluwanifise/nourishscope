{
  "name": "nourishscope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NourishScope: free, browser-based decision support for community nutrition programs in Kentucky.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build-data": "tsx scripts/build-data.ts",
    "predev": "npm run build-data",
    "dev": "astro dev",
    "prebuild": "npm run build-data",
    "build": "astro build",
    "preview": "astro preview",
    "pretest": "npm run build-data",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "tsx scripts/check-bundle-size.ts",
    "test:e2e": "playwright test",
    "check": "astro check && vitest run && npm run build && npm run check:size && playwright test",
    "precheck": "npm run build-data"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "astro": "^7.3.8",
    "papaparse": "^5.7.0",
    "preact": "^10.29.8",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
